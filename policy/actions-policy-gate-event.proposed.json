{
  "name": "ci1-gate-allow-pull-request-target",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/ci1-trusted-gate.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target"]
      }
    }
  ]
}
